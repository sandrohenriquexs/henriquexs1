algoritmo "alg01"

var
idade: inteiro
datanacimento: caractere
maioridade: logico
salario:real

inicio
//idade<- 35
datanacimento <- "08/04/1991"
maioridade <- verdadeiro
salario <- //10000.50

escreval(idade)
escreval(datanacimento)
escreval(maioridade)
escreval(salario)

escreval("qual a sua idade")
leia(idade)

se ((idade >= 18 )) e ((salario >= 10000.50)) entao
   escreva ("voce e maior de iadade!")
senao
   escreva ("voce e menor de idade")
fimse



fimalgoritmo