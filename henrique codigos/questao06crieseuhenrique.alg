algoritmo "cria forma de pagamento"



var
qtdpedidos: inteiro
valorpedido: real
formapagamento:caractere


inicio
escreval("quantiades de pedidos")
leia(qtdpedidos)

escreval("valor do pedido")
leia(valorpedido)


escreval("forma de pagamento")
leia(formapagamento)

se qtdpedidos <= 5 entao
escreval("valorpedido:", 50) entao
escreval("formapagamento e:", formapagamento)
escreval("pagamento a provado")
fimse


fimalgoritmo
