algoritmo "mediaaprovado"



var
nota1, nota2, nota3, nota4:real
nome:caractere
media:real


inicio
//nome<- arthur
//nota1<-
//nota2<-
//nota3<-
//nota4<-
//media<-


//escreva(nomedoaluno)
//escreva(nota1)
//escreva(nota2)
//escreva(nota3)
//escreva(nota4)


escreval("qual o nome")
leia(nome)

escreval("qualnota1 ")
leia(nota1)

escreval("qualnota2")
leia(nota2)

escreval("qualnota3")
leia(nota3)

escreval("qualnota4")
leia(nota4)

media <- (nota1+nota2+nota3+nota4)/4

se media>= 6.0 entao

escreva("  voce foi aprovado!")

senao

escreva("voce foi reprovado")


fimse

escreval("aluno:",nome,,"sua foi media:",media)







fimalgoritmo




