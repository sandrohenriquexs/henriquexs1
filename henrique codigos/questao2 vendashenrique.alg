algoritmo "resultadosdevendas"



var
jan,fev,mar:real
soma:real


inicio
escreval("valor de vendas de janeiro")
leia(jan)


escreval("valor de vendas de fevereiro")
leia(fev)

escreval("valor de vendas de marco")
leia(mar)

soma<-(jan+fev+mar)

se soma>=170000 entao
escreval("parabens voce atigiu a meta de vendas")
fimse


senao
escreval("voce nao atingiu a meta de vendas")


fimse




fimalgoritmo
