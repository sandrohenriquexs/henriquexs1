algoritmo "caratteristicascarro"


var
cor,fabricante: caractere
motor,valor:real

inicio
escreval("qual fabricante")
leia(fabricante)

escreval("cor do carro")
leia(cor)


escreval("qual motor do carro")
leia(motor)

escreval("qual valor do carro")
leia(valor)




se cor = "azul" e fabricante = "ford" e motor = 1.8 e valor >= 40000 entao
escreval("encontramos o carro desejado") senao escreval("nao encontramos o carro desejado")

fimse   
   
   

fimalgoritmo